{
  "name": "@es11225599/systemone-mcp",
  "version": "0.1.0",
  "description": "stdio MCP server for any System One backend (Ollama nimble/tev/clef, TypeSafe jev, Kev, Laya). Run with npx or bunx, no build required.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "system-one",
    "typesafe",
    "ollama",
    "nimble",
    "tev",
    "clef",
    "jev",
    "kev",
    "laya",
    "ai-agent"
  ],
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/es11225599/systemone-mcp.git"
  },
  "homepage": "https://github.com/es11225599/systemone-mcp#readme",
  "bugs": {
    "url": "https://github.com/es11225599/systemone-mcp/issues"
  },
  "bin": {
    "systemone-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm run test",
    "release": "npm publish --access public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.16.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^20.16.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
